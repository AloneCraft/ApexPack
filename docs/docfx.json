{
  "build": {
    "content": ["index.md", "quickstart.md", "performance.md", "benchmark-results.md", "WireFormat.md", "toc.yml"],
    "resource": ["images/*.png", "data/*.csv", "examples/QuickStart.cs"],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "ApexPack",
      "_appTitle": "ApexPack",
      "_enableSearch": true,
      "_lang": "en"
    },
    "fileMetadata": {
      "_lang": {
        "quickstart.md": "ja",
        "WireFormat.md": "ja"
      }
    }
  }
}
